# .env.prod

# Django settings
DEBUG=0
SECRET_KEY=change_me_to_a_long_random_string
DJANGO_ALLOWED_HOSTS=your_domain.com,www.your_domain.com

# Database settings
DATABASE_URL=postgres://grm_db_user:Your_Postgres_Pwd@db/grm_database_name

# Static files
STATIC_URL=/static/
STATIC_ROOT=/app/src/dashboard/static

# Celery settings
CELERY_BROKER_URL=amqp://grm_redis_user:grm_redis_user_password@redis/grm_vhost

# Other application-specific settings
# Add any other environment variables your application needs