{
  "_id": "_design/eadl",
  "views": {
    "all_communes": {
      "map": "function (doc) {\n  if(doc.type === 'administrative_level')\n    emit(doc._id, doc);\n}"
    },
    "all_administrative_levels": {
      "map": "function (doc) {\n  if(doc.type === 'administrative_level')\n    emit(doc._id, doc);\n}"
    },
    "by_representative_email": {
      "map": "function(doc) { \n  if (doc.representative && doc.representative.email) {\n    emit(doc.representative.email, null);\n  }\n}"
    }
  },
  "filters": {
    "by_user_email": "function (doc, req) {\n return doc._id === '_design/eadl' || (doc.representative && doc.representative.email === req.query.email); \n}",
    "by_user_administrative_region": "function (doc, req) {\n return doc.type === 'administrative_level' && req.query.ids.includes('$'+doc.administrative_id+'$'); \n}"
  },
